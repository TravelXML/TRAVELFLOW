# --- Core (required) ---
DATABASE_URL=postgresql://travelflow:travelflow@localhost:5544/travelflow_dev
REDIS_URL=redis://localhost:6390
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:3001
LOG_LEVEL=info

# --- Providers: leave unset to use the built-in mock provider (see src/services/providers) ---

# Claude API - set to enable real AI itinerary generation, otherwise a deterministic mock itinerary is used
ANTHROPIC_API_KEY=

# Flights - Skyscanner via RapidAPI
SKYSCANNER_API_KEY=

# Hotels - RapidAPI Hotels
RAPIDAPI_HOTELS_KEY=

# Activities - GetYourGuide
GETYOURGUIDE_API_KEY=

# Email - Mailgun. Without these, emails are logged to console/disk instead of sent.
MAILGUN_API_KEY=
MAILGUN_DOMAIN=

# File storage - AWS S3. Without these, generated PDFs are written to apps/api/uploads and served statically.
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

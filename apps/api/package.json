{
  "name": "@travelflow/api",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup src/index.ts --format cjs --outDir dist --clean --sourcemap",
    "start": "node dist/index.js",

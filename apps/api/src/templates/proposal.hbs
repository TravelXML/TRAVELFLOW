<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8" />
<style>
  body { font-family: 'Helvetica Neue', Arial, sans-serif; color: #1a1a1a; margin: 0; padding: 40px; }
  .header { display: flex; align-items: center; justify-content: space-between; border-bottom: 3px solid {{primaryColor}}; padding-bottom: 16px; margin-bottom: 24px; }
  .agency { font-size: 14px; color: #666; }
  h1 { color: {{primaryColor}}; font-size: 28px; margin: 0 0 4px; }
  .subtitle { color: #555; font-size: 14px; margin-bottom: 24px; }
  .summary { background: {{secondaryColor}}22; border-left: 4px solid {{secondaryColor}}; padding: 12px 16px; border-radius: 4px; margin-bottom: 24px; }
  .day { margin-bottom: 20px; page-break-inside: avoid; }
  .day-title { font-size: 18px; font-weight: bold; color: {{primaryColor}}; margin-bottom: 8px; }
  table { width: 100%; border-collapse: collapse; }
  td { padding: 6px 8px; font-size: 13px; vertical-align: top; border-bottom: 1px solid #eee; }
  .time { width: 110px; font-weight: 600; color: #333; }
  .duration { width: 90px; color: #888; text-align: right; }
  .total-cost { margin-top: 28px; padding: 16px; background: #f7f7f7; border-radius: 6px; font-size: 16px; font-weight: bold; text-align: right; }
  .footer { margin-top: 32px; font-size: 11px; color: #999; text-align: center; }
  .section-title { font-size: 15px; font-weight: bold; color: {{primaryColor}}; text-transform: uppercase; letter-spacing: 0.04em; margin: 0 0 12px; }
  .booking-section { margin-bottom: 28px; page-break-inside: avoid; }
  .booking-grid { display: flex; flex-wrap: wrap; gap: 12px; }
  .booking-card { flex: 1 1 220px; border: 1px solid #e5e5e5; border-radius: 8px; padding: 12px 14px; }
  .booking-kind { font-size: 10px; text-transform: uppercase; letter-spacing: 0.06em; color: #999; margin-bottom: 4px; }
  .booking-label { font-size: 14px; font-weight: 600; color: #1a1a1a; margin-bottom: 2px; }
  .booking-note { font-size: 11px; color: #888; margin-bottom: 6px; }
  .booking-price { font-size: 15px; font-weight: bold; color: {{primaryColor}}; margin-bottom: 10px; }
  .book-btn { display: inline-block; padding: 7px 14px; background: {{primaryColor}}; color: #fff; border-radius: 5px; font-size: 12px; font-weight: 600; text-decoration: none; }
  .trip-details { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 20px; }
  .trip-chip { font-size: 11px; color: #555; background: #f2f2f2; border-radius: 12px; padding: 4px 10px; }
</style>
</head>
<body>
  <div class="header">
    <div>
      <h1>{{title}}</h1>
      <div class="subtitle">Prepared for {{customerName}} &middot; {{numTravelers}} traveler(s) &middot; {{destination}}</div>
    </div>
    {{#if agencyName}}<div class="agency">{{agencyName}}</div>{{/if}}
  </div>

  <div class="trip-details">
    {{#each tripDetails}}
    <span class="trip-chip">{{this}}</span>
    {{/each}}
  </div>

  <div class="summary">{{summary}}</div>

  <div class="booking-section">
    <div class="section-title">Book this trip</div>
    <div class="booking-grid">
      {{#if flightLink}}
      <div class="booking-card">
        <div class="booking-kind">Flight</div>
        <div class="booking-label">{{flightLink.label}}</div>
        <div class="booking-price">${{flightLink.price}}</div>
        <a class="book-btn" href="{{flightLink.bookUrl}}">Book flight</a>
      </div>
      {{/if}}
      {{#if hotelLink}}
      <div class="booking-card">
        <div class="booking-kind">Hotel</div>
        <div class="booking-label">{{hotelLink.label}}</div>
        {{#if hotelLink.note}}<div class="booking-note">{{hotelLink.note}}</div>{{/if}}
        <div class="booking-price">${{hotelLink.price}}/night</div>
        <a class="book-btn" href="{{hotelLink.bookUrl}}">Book hotel</a>
      </div>
      {{/if}}
      {{#each activityLinks}}
      <div class="booking-card">
        <div class="booking-kind">Activity</div>
        <div class="booking-label">{{label}}</div>
        <div class="booking-price">${{price}}</div>
        <a class="book-btn" href="{{bookUrl}}">Book activity</a>
      </div>
      {{/each}}
    </div>
  </div>

  {{#each days}}
  <div class="day">
    <div class="day-title">Day {{day}}: {{title}}</div>
    <table>
      {{#each schedule}}
      <tr>
        <td class="time">{{time}}</td>
        <td>{{activity}}</td>
        <td class="duration">{{duration}}</td>
      </tr>
      {{/each}}
    </table>
  </div>
  {{/each}}

  <div class="total-cost">Estimated total: ${{totalCost}}</div>

  <div class="footer">Generated by TravelFlow{{#if agencyName}} for {{agencyName}}{{/if}}</div>
</body>
</html>
